{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/templates", "dest": "/api/templates.py" },
    { "src": "/api/watchlist", "dest": "/api/watchlist.py" },
    { "src": "/api/quote", "dest": "/api/quote.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
